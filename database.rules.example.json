{
  "rules": {
    "admin_uids": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "students": {
      ".read": "auth != null && root.child('admin_uids').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admin_uids').child(auth.uid).val() === true",
      "$studentKey": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous'"
      }
    },
    "system_config": {
      "daily_targets": {
        ".read": "auth != null && (root.child('admin_uids').child(auth.uid).val() === true || auth.token.firebase.sign_in_provider === 'anonymous')",
        ".write": "auth != null && root.child('admin_uids').child(auth.uid).val() === true"
      },
      "admin_accounts": {
        ".read": false,
        ".write": false
      }
    },
    "expenses_categories": {
      ".read": "auth != null && (root.child('admin_uids').child(auth.uid).val() === true || auth.token.firebase.sign_in_provider === 'anonymous')",
      ".write": "auth != null && root.child('admin_uids').child(auth.uid).val() === true"
    },
    "transaction_logs": {
      ".read": "auth != null && root.child('admin_uids').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admin_uids').child(auth.uid).val() === true"
    },
    "homework_logs": {
      ".read": "auth != null && root.child('admin_uids').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admin_uids').child(auth.uid).val() === true"
    }
  }
}
